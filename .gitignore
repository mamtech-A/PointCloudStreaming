.venv/
.vscode
# logs/ is scratch. Overnight training runs are NO LONGER shipped via git
# (raw train_runs bloated the repo to a ~245 MB pack). The reviewable
# artifacts — TRAINING_SUMMARY_*.md and the result JSONs — are installed
# under models/, which is tracked.
logs/
__pycache__/
src/__pycache__
# legacy pre-refactor module kept on disk as local reference only
src/network_model.py.bak
# G-PCC: cloned codec source/build + generated bitstreams (large, regenerable)
# (encoded_<seq>/ dirs for the other 8i sequences included)
gpcc/mpeg-pcc-tmc13/
gpcc/encoded*/
# Raw 5G dataset download/extraction (only cleaned bandwidth_5g/ is tracked)
data/5g_raw/
# Regenerable LSTM achieved-bandwidth CSVs (tens of thousands of tiny files,
# rebuilt by the LSTM data-prep step) — never commit.
data/lstm_achieved*/
# Large regenerable audit dumps — keep the human-readable .md summaries,
# drop the multi-MB raw JSON (rebuilt by the trace-window audit).
reports/*_audit.json
reports/trace_window_registry_all_candidates.json
reports/high_tier_candidate_audit.json
!reports/trace_gap_audit.json
