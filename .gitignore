.venv/
.vscode
# logs/ is scratch EXCEPT train_runs (overnight-run logs travel via git for review);
# bulky per-trial checkpoints inside a sweep stay local — winners are installed to models/.
logs/*
!logs/train_runs/
logs/train_runs/*/sweep/trial_*/*.pkl
logs/train_runs/*/lstm/*.pkl
__pycache__/
src/__pycache__
# legacy pre-refactor module kept on disk as local reference only
src/network_model.py.bak
# G-PCC: cloned codec source/build + generated bitstreams (large, regenerable)
# (encoded_<seq>/ dirs for the other 8i sequences included)
gpcc/mpeg-pcc-tmc13/
gpcc/encoded*/
# Raw 5G dataset download/extraction (only cleaned bandwidth_5g/ is tracked)
data/5g_raw/
